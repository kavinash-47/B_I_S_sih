# Copy to .env and adjust as needed. All have working defaults.
CONFIDENCE_THRESHOLD=0.15
BM25_WEIGHT=0.5
SEMANTIC_WEIGHT=0.5

# Leave as TFIDF_FALLBACK for offline CPU operation with zero downloads.
# Or set to a sentence-transformers model name, e.g. BAAI/bge-m3, to use
# a real embedding model if sentence-transformers is installed and the
# model can be downloaded/cached. If loading fails for any reason the
# system automatically falls back to TF-IDF and reports this in the API
# response's "semantic_engine" field.
EMBEDDING_MODEL=TFIDF_FALLBACK
